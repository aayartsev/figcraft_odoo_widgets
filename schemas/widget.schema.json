{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figcraft.local/schemas/odoo-widget.schema.json",
  "title": "Виджет Odoo для FigCraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "class",
    "odooVersion",
    "category",
    "description",
    "size",
    "slots",
    "variants",
    "figcraft"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "class": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "odooVersion": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "shell",
        "navbar_widgets",
        "menu",
        "views",
        "fields",
        "custom_views",
        "discussion",
        "custom"
      ]
    },
    "description": { "type": "string", "minLength": 1 },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "accepts"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "accepts": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "slotAnchors": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "figcraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "root"],
      "properties": {
        "kind": { "type": "string", "const": "fragment" },
        "root": { "$ref": "#/$defs/node" }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "frame",
            "rectangle",
            "ellipse",
            "polygon",
            "star",
            "line",
            "arrow",
            "text",
            "vector",
            "section",
            "component",
            "slice"
          ]
        },
        "name": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "text": { "type": "string" },
        "props": { "type": "object" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "additionalProperties": false
    }
  }
}
