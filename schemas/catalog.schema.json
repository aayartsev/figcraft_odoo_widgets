{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figcraft.local/schemas/odoo-widget-catalog.schema.json",
  "title": "Каталог виджетов Odoo (обёртка)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "odooVersion", "widgets"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "odooVersion": { "type": "string", "minLength": 1 },
    "widgets": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "category",
        "path",
        "description",
        "size",
        "slots",
        "variants"
      ],
      "properties": {
        "class": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "category": {
          "type": "string",
          "enum": [
            "shell",
            "navbar_widgets",
            "menu",
            "views",
            "fields",
            "custom_views",
            "discussion",
            "custom"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "accepts"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "accepts": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
